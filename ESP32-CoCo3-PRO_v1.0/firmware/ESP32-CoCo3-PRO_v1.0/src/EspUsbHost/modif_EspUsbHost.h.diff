+  };
+  static constexpr uint8_t COCO_HID_MAX_PENDING = 8;
+  CocoHidPending cocoHidPending_[COCO_HID_MAX_PENDING];
+  bool cocoHidFilter_ = true;
+  bool cocoLatePass_ = false;
+  uint32_t cocoLastNewDeviceMs_ = 0;
+  esp_err_t cocoDecideHidClaim(DeviceState &device, const usb_intf_desc_t *intf);
+  void cocoOnHidReportDescriptor(DeviceState &device, uint8_t iface, const uint8_t *data, size_t length);
+  void cocoProcessPendingHid();
+  bool cocoClaimHidLate(DeviceState &device, uint8_t iface, uint8_t alt);
+  void cocoSetInterfaceState(DeviceState &device, uint8_t iface, uint8_t alt, esp_err_t state);
+  bool cocoOtherKeyboardClaimed(const DeviceState &device) const;
+  void cocoForgetDevice(usb_device_handle_t handle);
