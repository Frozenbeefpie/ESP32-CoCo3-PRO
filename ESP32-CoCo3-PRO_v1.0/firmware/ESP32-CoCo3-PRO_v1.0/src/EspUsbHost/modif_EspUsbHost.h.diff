@@ -156,7 +156,8 @@
 
 struct EspUsbHostConfig
 {
-  uint32_t taskStackSize = 8192;
+  uint32_t taskStackSize = 8192;      // pile de la tâche client (rappels clavier/souris)
+  uint32_t hostTaskStackSize = 0;     // CoCo3 6d : pile de la tâche hôte (0 = taskStackSize)
   UBaseType_t taskPriority = 5;
   BaseType_t taskCore = tskNO_AFFINITY;
   EspUsbHostPort port = ESP_USB_HOST_PORT_DEFAULT;
@@ -1305,6 +1306,19 @@
   void printDeviceInfo(uint8_t address, bool includeHubInfo = false, Print &out = Serial);
   void printAllDeviceInfo(Print &out = Serial);
 
+  // ESP32-CoCo3 6c : filtre des interfaces HID (voir EspUsbHost.cpp, « CoCo3 6c »).
+  // Le contrôleur hôte de l'ESP32-S3 n'a que 8 canaux : chaque interface réclamée
+  // en prend un par point d'accès. Avec le filtre, seules les interfaces clavier,
+  // souris et manette sont réclamées ; le clavier d'un récepteur combiné
+  // clavier+souris n'est réclamé que si aucun autre clavier n'est branché.
+  void setHidInterfaceFilter(bool enabled) { cocoHidFilter_ = enabled; }
+  bool hidInterfaceFilter() const { return cocoHidFilter_; }
+  // CoCo3 6d : marge restante des piles des deux tâches (octets jamais utilisés)
+  uint32_t hostTaskStackFree() const { return taskHandle_ ? (uint32_t)uxTaskGetStackHighWaterMark(taskHandle_) : 0; }
+  uint32_t clientTaskStackFree() const { return clientTaskHandle_ ? (uint32_t)uxTaskGetStackHighWaterMark(clientTaskHandle_) : 0; }
+  uint32_t hostTaskStackSize() const { return config_.hostTaskStackSize ? config_.hostTaskStackSize : config_.taskStackSize; }
+  uint32_t clientTaskStackSize() const { return config_.taskStackSize; }
+
 private:
