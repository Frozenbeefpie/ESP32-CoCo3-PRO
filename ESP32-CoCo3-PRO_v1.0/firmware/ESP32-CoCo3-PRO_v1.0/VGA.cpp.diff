+// Diviseur d'horloge LCD_CAM : f = 240 MHz / (N + B/A).
+// Comportement d'origine conservé : diviseur ENTIER (A = B = 0) dès que
+// l'arrondi entier tombe à moins de 2 % de la fréquence demandée (c'est le
+// cas de tous les modes existants, ex. 12 587 500 Hz -> N = 19, 12,63 MHz).
+// Sinon (ex. mode 640 GIME à 25 263 158 Hz = 240/9,5 MHz, soit exactement
+// 2 x l'horloge du mode 320 4:3), partie fractionnaire B/A (A <= 63, B < A)
+// pour obtenir un balayage identique au mode 320 : même fréquence ligne et
+// trame, le moniteur ne resynchronise pas (ou très peu) au changement.
+static void computeClockDivider(int frequency, int &N, int &divA, int &divB)
+{
+	const double div = 240000000.0 / (double)frequency;
+	N    = (int)round(div);
+	divA = 0;
+	divB = 0;
+	if (N < 2) N = 2;
+	if (fabs(240000000.0 / N - frequency) <= 0.02 * frequency)
+		return;
+	N = (int)floor(div);
+	if (N < 2) N = 2;
+	const double frac = div - N;
+	double bestErr = 1.0;
+	for (int a = 2; a <= 63; a++)
+	{
+		int b = (int)round(frac * a);
+		if (b <= 0 || b >= a) continue;
+		double err = fabs(frac - (double)b / a);
+		if (err < bestErr - 1e-9) { bestErr = err; divA = a; divB = b; }
+	}
+}
